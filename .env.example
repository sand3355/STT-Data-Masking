# SAP AI Core configuration
SAP_AI_CORE_INFERENCE_URL=https://api.ai.internalprod.eu-central-1.aws.ml.hana.ondemand.com
SAP_AI_CORE_OAUTH_URL=https://your-subaccount.authentication.eu10.hana.ondemand.com
SAP_AI_CORE_CLIENT_ID=sb-your-client-id
SAP_AI_CORE_CLIENT_SECRET=your-client-secret
# Optional — leave blank to auto-discover a running Claude deployment at startup
SAP_AI_CORE_DEPLOYMENT_ID=
SAP_AI_CORE_RESOURCE_GROUP=default

# Server
PORT=3000
LOG_LEVEL=info
MAX_FILE_SIZE_MB=10
