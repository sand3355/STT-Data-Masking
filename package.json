{
  "name": "m9-stt-vendor-masking",
  "version": "1.0.0",
  "description": "Vendor pricing document masking PoC using SAP AI Core",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc && npm run build:frontend",
    "build:frontend": "npm install --prefix frontend && npm run build --prefix frontend",
    "dev": "tsx watch src/index.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.7.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174",
    "pdfkit": "^0.15.0",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.10",
    "@types/pdfkit": "^0.13.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
